# Copiá este archivo como .env para trabajar en tu compu (lo leen Prisma y Next.js).
# En Vercel se cargan en Settings > Environment Variables. Nunca subas valores reales al repo.

# Base de datos Postgres (Prisma Postgres creada desde Vercel > Storage).
# En local podés usar `npx prisma dev`, que te muestra la URL para pegar acá.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/dprint"

# Fotos de productos en Vercel Blob. Vercel la crea sola al conectar un Blob Store
# al proyecto (Storage > Blob). Sin esta variable el panel funciona, pero sin fotos.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_ejemplo_reemplazar

# Ingreso al panel /admin. Sin estas tres variables el panel no deja entrar.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-por-una-clave-larga
# Mínimo 32 caracteres. Generá una con: openssl rand -base64 48
AUTH_SECRET=reemplazar-por-un-texto-aleatorio-de-32-caracteres-o-mas

# Opcional: WhatsApp que recibe los pedidos (solo números, con código de país).
# Si no se configura, los pedidos de la demo le llegan a David.dev.
# WHATSAPP_NUMBER=5491100000000
